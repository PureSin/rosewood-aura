# Anthropic
ANTHROPIC_API_KEY=

# Exa (guest research skill — falls back to mock data if unset)
EXA_API_KEY=
ANTHROPIC_AGENT_ID=
ANTHROPIC_ENVIRONMENT_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Vapi (phone channel). Use the PRIVATE key, not the public one.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Optional: shared secret Vapi sends as x-vapi-secret on webhooks
VAPI_WEBHOOK_SECRET=
# Optional overrides
VAPI_MODEL=claude-sonnet-4-20250514
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot
# Public URL of this server (e.g. ngrok) used for Vapi webhooks
PUBLIC_BASE_URL=

# Email (SendGrid or Postmark)
SENDGRID_API_KEY=
INBOUND_EMAIL_WEBHOOK_SECRET=

# Guest / Demo config
DEMO_GUEST_NAME=
DEMO_GUEST_PHONE=
DEMO_GUEST_EMAIL=
